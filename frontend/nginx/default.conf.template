# Resolve the API through Docker's embedded DNS at runtime instead of once at
# startup, so nginx still boots (and recovers) if the api container is down.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream api_upstream {
  zone api_upstream 64k;
  server api:4000 resolve;
  keepalive 32;
}

server {
  listen 8080;
  server_name _;
  # Always to the configured address, never to whatever Host the request named.
  location / { return 301 ${APP_ORIGIN}$request_uri; }
}

server {
  listen 8443 ssl;
  http2 on;
  server_name _;

  ssl_certificate /etc/nginx/certs/tls.crt;
  ssl_certificate_key /etc/nginx/certs/tls.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  root /usr/share/kanforge/www;
  limit_conn conn 50;
  # Relative Location headers, so redirects keep whatever host and port the browser used.
  absolute_redirect off;

  include /etc/nginx/snippets/security-headers.conf;

  # Only the methods the app actually uses.
  if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$) { return 405; }

  location /api/auth/ {
    limit_req zone=auth burst=10 nodelay;
    include /etc/nginx/snippets/proxy.conf;
  }

  location /api/ {
    limit_req zone=api burst=60 nodelay;
    include /etc/nginx/snippets/proxy.conf;
  }

  # Bulk card and checklist imports need a larger body than the 64k default.
  location ~ ^/api/boards/[^/]+/cards/(?:[^/]+/checklist/)?bulk$ {
    limit_req zone=api burst=60 nodelay;
    client_max_body_size 256k;
    include /etc/nginx/snippets/proxy.conf;
  }

  # A note's content, and note imports, can be larger than the 64k default.
  location /api/notes {
    limit_req zone=api burst=60 nodelay;
    client_max_body_size 256k;
    include /etc/nginx/snippets/proxy.conf;
  }

  # Office documents can reach 3 MB, and image uploads 8 MB (a 5 MB image, base64-encoded).
  location /api/office {
    limit_req zone=api burst=60 nodelay;
    client_max_body_size 8m;
    include /etc/nginx/snippets/proxy.conf;
  }

  # File uploads arrive in parts of a few MB (6 MB at most, see the API's
  # files/uploads.js). Each part is passed to the API as it arrives instead of
  # being written to disk first, and gets longer than usual on a slow connection.
  location ~ ^/api/files/uploads/[a-f0-9]{24}/parts/[0-9]+$ {
    limit_req zone=api burst=60 nodelay;
    client_max_body_size 8m;
    client_body_timeout 60s;
    proxy_request_buffering off;
    include /etc/nginx/snippets/proxy.conf;
  }

  # Preview images for the Files grid view: a few hundred KB at most (see the
  # API's files/thumbnails.js).
  location ~ ^/api/files/nodes/[a-f0-9]{24}/thumbnail$ {
    limit_req zone=api burst=60 nodelay;
    client_max_body_size 512k;
    include /etc/nginx/snippets/proxy.conf;
  }

  # File downloads (signed links and public links) stream straight through,
  # however large the file, without nginx buffering them to disk.
  location /api/public/files/ {
    limit_req zone=api burst=60 nodelay;
    proxy_buffering off;
    include /etc/nginx/snippets/proxy.conf;
  }

  # The React app lives under /app/. A hosted build can add its own pages at /
  # (see the site stage in the Dockerfile). Keep the paths in sync with vite.config.js.
  location = /app { return 301 /app/$is_args$args; }

  # Old app URLs (from before the /app/ move) keep working.
  location ~ ^/(?:login|register|account|admin|boards|notes|office|b)(?:/|$) {
    return 301 /app$request_uri;
  }

  # Hashed build assets are immutable, so they can be cached for a year.
  location /app/assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # SPA fallback. index.html is never cached, so deploys take effect immediately.
  location /app/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /app/index.html;
  }

  # Site pages if the build has any (/pricing serves pricing.html or
  # pricing/index.html), with the site's own 404 page for anything else.
  # Without a site, everything else opens the app.
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri.html $uri/index.html @nopage;
  }

  location @nopage {
    if (-f $document_root/index.html) { return 404; }
    return 302 /app/;
  }

  # A server's own robots.txt, if its site has one. Otherwise search engines are
  # asked to stay out, so a private install doesn't end up in search results.
  location = /robots.txt {
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri @norobots;
  }

  location @norobots {
    include /etc/nginx/snippets/security-headers.conf;
    default_type text/plain;
    return 200 "User-agent: *\nDisallow: /\n";
  }

  error_page 404 /404.html;

  # Never serve dotfiles.
  location ~ /\. { deny all; return 404; }
}
