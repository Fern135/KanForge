# Resolve the API through Docker's embedded DNS at runtime instead of once at
# startup, so nginx still boots (and recovers) if the api container is down.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream api_upstream {
  zone api_upstream 64k;
  server api:4000 resolve;
  keepalive 32;
}

server {
  listen 8080;
  server_name _;
  location / { return 301 https://$host:${PUBLIC_HTTPS_PORT}$request_uri; }
}

server {
  listen 8443 ssl;
  http2 on;
  server_name _;

  ssl_certificate /etc/nginx/certs/tls.crt;
  ssl_certificate_key /etc/nginx/certs/tls.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  root /usr/share/nginx/html;
  limit_conn conn 50;

  include /etc/nginx/snippets/security-headers.conf;

  # Only the methods the app actually uses.
  if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$) { return 405; }

  location /api/auth/ {
    limit_req zone=auth burst=10 nodelay;
    include /etc/nginx/snippets/proxy.conf;
  }

  location /api/ {
    limit_req zone=api burst=60 nodelay;
    include /etc/nginx/snippets/proxy.conf;
  }

  # Bulk card and checklist imports need a larger body than the 64k default.
  location ~ ^/api/boards/[^/]+/cards/(?:[^/]+/checklist/)?bulk$ {
    limit_req zone=api burst=60 nodelay;
    client_max_body_size 256k;
    include /etc/nginx/snippets/proxy.conf;
  }

  # Hashed build assets are immutable, so they can be cached for a year.
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # SPA fallback. index.html is never cached, so deploys take effect immediately.
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }

  # Never serve dotfiles.
  location ~ /\. { deny all; return 404; }
}
