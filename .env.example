COMPOSE_PROJECT_NAME=kanforge
HTTP_PORT=8080
HTTPS_PORT=8443
APP_ORIGIN=https://localhost:8443

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=<generated by make setup>
MONGO_APP_DB=kanforge
MONGO_APP_USER=kanforge_app
MONGO_APP_PASSWORD=<generated by make setup>
MONGO_MIGRATE_USER=kanforge_migrate
MONGO_MIGRATE_PASSWORD=<generated by make setup>

REDIS_PASSWORD=<generated by make setup>

JWT_ACCESS_SECRET=<generated by make setup>
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=14
LOG_LEVEL=info

# Plan new workspaces start on: self-hosted (every app, no limits), standard or plus.
# The hosted service must set this to standard, or every new workspace gets every app.
# DEFAULT_PLAN=self-hosted

# Object storage for the Files app (Garage, running in Docker on this machine).
# To use a hosted S3-compatible service instead (Backblaze B2, Cloudflare R2,
# AWS S3...), set S3_ENDPOINT and S3_REGION, and the bucket and keys to its values.
GARAGE_RPC_SECRET=<generated by make setup>
S3_BUCKET=kanforge-files
S3_ACCESS_KEY_ID=<generated by make setup>
S3_SECRET_ACCESS_KEY=<generated by make setup>
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
