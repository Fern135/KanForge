COMPOSE_PROJECT_NAME=kanforge
HTTP_PORT=8080
HTTPS_PORT=8443
APP_ORIGIN=https://localhost:8443

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=<generated by make setup>
MONGO_APP_DB=kanforge
MONGO_APP_USER=kanforge_app
MONGO_APP_PASSWORD=<generated by make setup>
MONGO_MIGRATE_USER=kanforge_migrate
MONGO_MIGRATE_PASSWORD=<generated by make setup>

REDIS_PASSWORD=<generated by make setup>

JWT_ACCESS_SECRET=<generated by make setup>
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=14
LOG_LEVEL=info
